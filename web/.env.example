# 6 Stars Clips console — environment variables (copy to .env.local for local work; set in Vercel for deployments).
# Every variable is server-only: none of them is exposed to the browser.

# Which stack this deployment shows: production | staging | dev
APP_ENV=staging

# The one account allowed to sign in. Any other session is refused.
ADMIN_EMAIL=

# Supabase Auth of THIS environment's Supabase project (Project Settings → API).
# Use the publishable (anon) key, never the service-role key. Turn sign-ups off in Auth settings
# and create the operator user by hand in the dashboard.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=

# Control API of the same environment, and the dashboard token (DASHBOARD_API_TOKEN in the server .env).
CONTROL_API_URL=https://api-staging.example
DASHBOARD_API_TOKEN=

# ---- Local development only (ignored on Vercel) ----
# Without Supabase settings the console uses a local dev login:
# DEV_ADMIN_PASSWORD=
# SESSION_SECRET=           # any long random string
# Without CONTROL_API_URL / DASHBOARD_API_TOKEN (or with MOCK_API=1) it shows generated sample data.
# MOCK_API=1
