{
  "name": "[STG] WF09 Error Alert",
  "description": "Error workflow of every 6 Stars workflow: sends the failure to Telegram.",
  "active": true,
  "nodes": [
    {
      "id": "2fbc603f-6ca6-4507-8e44-1d63a25ad643",
      "name": "Error Trigger",
      "type": "n8n-nodes-base.errorTrigger",
      "typeVersion": 1,
      "position": [
        0,
        0
      ],
      "parameters": {}
    },
    {
      "id": "63f60bd3-f421-413d-a87a-8ec6c8662346",
      "name": "Config",
      "notes": "The only node that differs between staging and production (besides the credentials).",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        220,
        0
      ],
      "parameters": {
        "mode": "manual",
        "assignments": {
          "assignments": [
            {
              "id": "14ff0ac0-9ade-567f-a0b0-d5ea356a9bc4",
              "name": "API_BASE",
              "value": "https://api-staging.46.224.14.255.sslip.io",
              "type": "string"
            },
            {
              "id": "bc4519a9-9d44-5f27-96a9-c6b105fda5dc",
              "name": "TELEGRAM_CHAT_ID",
              "value": "<TELEGRAM_CHAT_ID>",
              "type": "string"
            },
            {
              "id": "b815debe-00de-5a07-9638-3b2edae920c6",
              "name": "ENV_PREFIX",
              "value": "[STG]",
              "type": "string"
            }
          ]
        },
        "includeOtherFields": false,
        "options": {}
      }
    },
    {
      "id": "939323ac-2052-4944-b37b-f1b56c2b7cd4",
      "name": "Send alert",
      "type": "n8n-nodes-base.telegram",
      "typeVersion": 1.2,
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 5000,
      "position": [
        440,
        0
      ],
      "parameters": {
        "resource": "message",
        "operation": "sendMessage",
        "chatId": "={{ $('Config').first().json.TELEGRAM_CHAT_ID }}",
        "text": "={{ (() => {\n  const e = $('Error Trigger').first().json;\n  const esc = (s) => String(s ?? '').replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');\n  const message = e.execution?.error?.message ?? e.trigger?.error?.message ?? 'no error message';\n  const failedNode = e.execution?.lastNodeExecuted ? ' (node: ' + e.execution.lastNodeExecuted + ')' : '';\n  const head = [$('Config').first().json.ENV_PREFIX, '🔴 n8n workflow failed:', esc(e.workflow?.name ?? 'unknown workflow')];\n  const url = e.execution?.url ?? 'no execution (the trigger failed)';\n  return head.filter(Boolean).join(' ') + ' — ' + esc(message.slice(0, 1500) + failedNode) + ' — ' + url;\n})() }}",
        "additionalFields": {
          "appendAttribution": false,
          "disable_web_page_preview": true,
          "parse_mode": "HTML"
        }
      },
      "credentials": {
        "telegramApi": {
          "name": "6stars Telegram"
        }
      }
    }
  ],
  "connections": {
    "Error Trigger": {
      "main": [
        [
          {
            "node": "Config",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Config": {
      "main": [
        [
          {
            "node": "Send alert",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "saveExecutionProgress": false,
    "saveManualExecutions": true,
    "saveDataErrorExecution": "all",
    "saveDataSuccessExecution": "none",
    "timezone": "UTC",
    "executionOrder": "v1"
  },
  "tags": [
    "6stars",
    "staging"
  ]
}
