{
  "name": "[STG] WF06 Daily Report",
  "description": "At 00:00 UTC, fetches the daily report and sends it to Telegram.",
  "active": false,
  "nodes": [
    {
      "id": "2ec86c7b-728e-48ee-9a08-1758ce35614c",
      "name": "Daily at 00:00 UTC",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [
        0,
        0
      ],
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "days",
              "daysInterval": 1,
              "triggerAtHour": 0,
              "triggerAtMinute": 0
            }
          ]
        }
      }
    },
    {
      "id": "7c37e535-cc63-4282-a85c-85bf1122c3fb",
      "name": "Config",
      "notes": "The only node that differs between staging and production (besides the credentials).",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        220,
        0
      ],
      "parameters": {
        "mode": "manual",
        "assignments": {
          "assignments": [
            {
              "id": "14ff0ac0-9ade-567f-a0b0-d5ea356a9bc4",
              "name": "API_BASE",
              "value": "https://api-staging.46.224.14.255.sslip.io",
              "type": "string"
            },
            {
              "id": "bc4519a9-9d44-5f27-96a9-c6b105fda5dc",
              "name": "TELEGRAM_CHAT_ID",
              "value": "<TELEGRAM_CHAT_ID>",
              "type": "string"
            },
            {
              "id": "b815debe-00de-5a07-9638-3b2edae920c6",
              "name": "ENV_PREFIX",
              "value": "[STG]",
              "type": "string"
            }
          ]
        },
        "includeOtherFields": false,
        "options": {}
      }
    },
    {
      "id": "aa9774d4-a01b-40ae-83f2-b6bed93c9de4",
      "name": "Fetch daily report",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 5000,
      "position": [
        440,
        0
      ],
      "parameters": {
        "method": "GET",
        "url": "={{ $('Config').first().json.API_BASE }}/v1/reports/daily?format=telegram",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "options": {
          "timeout": 30000
        }
      },
      "credentials": {
        "httpHeaderAuth": {
          "name": "6stars API staging"
        }
      }
    },
    {
      "id": "b911867b-adfc-4c6d-b109-b0862a1cf606",
      "name": "Send report",
      "type": "n8n-nodes-base.telegram",
      "typeVersion": 1.2,
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 5000,
      "position": [
        660,
        0
      ],
      "parameters": {
        "resource": "message",
        "operation": "sendMessage",
        "chatId": "={{ $('Config').first().json.TELEGRAM_CHAT_ID }}",
        "text": "={{ $json.text }}",
        "additionalFields": {
          "appendAttribution": false,
          "disable_web_page_preview": true,
          "parse_mode": "HTML"
        }
      },
      "credentials": {
        "telegramApi": {
          "name": "6stars Telegram"
        }
      }
    }
  ],
  "connections": {
    "Daily at 00:00 UTC": {
      "main": [
        [
          {
            "node": "Config",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Config": {
      "main": [
        [
          {
            "node": "Fetch daily report",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Fetch daily report": {
      "main": [
        [
          {
            "node": "Send report",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "saveExecutionProgress": false,
    "saveManualExecutions": true,
    "saveDataErrorExecution": "all",
    "saveDataSuccessExecution": "none",
    "errorWorkflow": "<id of [STG] WF09 Error Alert>",
    "timezone": "UTC",
    "executionOrder": "v1"
  },
  "tags": [
    "6stars",
    "staging"
  ]
}
