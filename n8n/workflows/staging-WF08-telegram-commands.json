      "waitBetweenTries": 5000,
      "position": [
        880,
        -180
      ],
      "parameters": {
        "method": "POST",
        "url": "={{ $('Config').first().json.API_BASE }}/v1/control/start",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "options": {
          "timeout": 30000
        }
      },
      "credentials": {
        "httpHeaderAuth": {
          "name": "6stars API staging"
        }
      }
    },
    {
      "id": "7a8c4ecf-5afb-471e-9745-01913b2321d3",
      "name": "Get status",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 5000,
      "position": [
        880,
        0
      ],
      "parameters": {
        "method": "GET",
        "url": "={{ $('Config').first().json.API_BASE }}/v1/status?format=telegram",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "options": {
          "timeout": 30000
        }
      },
      "credentials": {
        "httpHeaderAuth": {
          "name": "6stars API staging"
        }
      }
    },
    {
      "id": "48dd8f2d-d6f8-4d71-a52f-fd53b94053d1",
      "name": "Get daily report",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 5000,
      "position": [
        880,
        180
      ],
      "parameters": {
        "method": "GET",
        "url": "={{ $('Config').first().json.API_BASE }}/v1/reports/daily?format=telegram",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "options": {
          "timeout": 30000
        }
      },
      "credentials": {
        "httpHeaderAuth": {
          "name": "6stars API staging"
        }
      }
    },
    {
      "id": "10a2e4ca-6fb2-4c10-830a-8e05670e2d8b",
      "name": "Ignore other messages",
      "type": "n8n-nodes-base.noOp",
      "typeVersion": 1,
      "position": [
        880,
        360
      ],
      "parameters": {}
    },
    {
      "id": "c7781839-e70d-456f-b8f9-1d35461589f1",
      "name": "Reply",
      "type": "n8n-nodes-base.telegram",
      "typeVersion": 1.2,
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 5000,
      "position": [
        1100,
        -360
      ],
      "parameters": {
        "resource": "message",
        "operation": "sendMessage",
        "chatId": "={{ String($('Telegram Trigger').first().json.message?.chat?.id ?? '') }}",
        "text": "={{ $json.text ?? ($json.stopped === true ? '⛔ Emergency stop is ON: nothing will be posted.' : $json.stopped === false ? '✅ Emergency stop is OFF: posting resumed.' : JSON.stringify($json)) }}",
        "additionalFields": {
          "appendAttribution": false,
          "disable_web_page_preview": true,
          "parse_mode": "HTML"
        }
      },
      "credentials": {
        "telegramApi": {
          "name": "6stars Telegram"
        }
      }
    }
  ],
