# 6 Stars Clips — environment variables
# Copy to .env (never commit). One file per environment on each server.

# ── Environment ──────────────────────────────────────────────
APP_ENV=staging                     # staging | production
SERVICE_NAME=                       # set per container by docker compose
LOG_LEVEL=INFO
DATA_DIR=/data                      # scratch volume: buffers, downloads, renders

# ── Supabase ─────────────────────────────────────────────────
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=          # server only, used for Storage
DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres
                                    # session pooler (port 5432) for long-lived workers
DB_POOL_MAX=10

# ── Control API ──────────────────────────────────────────────
CONTROL_API_TOKEN=                  # long random string; n8n sends it as Bearer token
DASHBOARD_API_TOKEN=                # another long random string, for the admin console (web/); never the trigger routes
PUBLIC_API_HOST=api.staging.example.com   # Caddy issues HTTPS for this host

# ── n8n ──────────────────────────────────────────────────────
N8N_NOTIFY_WEBHOOK_URL=https://n8n.example.com/webhook/6stars-notify-staging
N8N_NOTIFY_SECRET=                  # shared secret header X-6Stars-Secret

# ── Anthropic ────────────────────────────────────────────────
ANTHROPIC_API_KEY=

# ── Transcription (express path) ─────────────────────────────
GROQ_API_KEY=
OPENAI_API_KEY=                     # fallback

# ── Twitch ───────────────────────────────────────────────────
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=

# ── YouTube ──────────────────────────────────────────────────
YOUTUBE_API_KEY=                    # public data (video status, stats)
YOUTUBE_OAUTH_CLIENT_ID=            # pre-check uploads (private) + deletes on own channel
YOUTUBE_OAUTH_CLIENT_SECRET=
YOUTUBE_OAUTH_REFRESH_TOKEN=        # created once with `sixstars youtube auth`
YOUTUBE_COOKIES_FILE=/secrets/youtube_cookies.txt   # optional, for yt-dlp

# ── Apify ────────────────────────────────────────────────────
APIFY_TOKEN=
APIFY_YOUTUBE_ACTOR=streamers/youtube-scraper       # verify in Apify Store

# ── Upload-Post ──────────────────────────────────────────────
UPLOAD_POST_API_KEY=

# ── Downloads ────────────────────────────────────────────────
PROXY_URL=http://user:pass@residential-proxy:port   # YouTube video downloads only (setting proxy.lanes)
PROXY_STICKY_PORT_MIN=                               # sticky-session port range, e.g. 10000 (DataImpulse)
PROXY_STICKY_PORT_MAX=                               # e.g. 20000; one random port per video job
POT_PROVIDER_URL=                                    # PO-token server; set by docker-compose (http://bgutil:4416)
TWITCH_DOWNLOADER_CLI=/usr/local/bin/TwitchDownloaderCLI

# ── Telegram (used by n8n, listed here for reference only) ───
# TELEGRAM_BOT_TOKEN and TELEGRAM_CHAT_ID are stored as n8n credentials, not here.
